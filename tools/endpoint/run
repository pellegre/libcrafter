#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/../.." && pwd)"

export WIRE_REPO_ROOT="${repo_root}"
export LIBCRAFTER_REPO_ROOT="${LIBCRAFTER_REPO_ROOT:-${repo_root}}"
export PYTHONPATH="${script_dir}${PYTHONPATH:+:${PYTHONPATH}}"

uv_bin="${WIRE_UV:-uv}"
python_bin="${WIRE_PYTHON:-python3}"

if ! uv_path="$(command -v "${uv_bin}")"; then
    echo "error: uv is required to run wire Python tooling" >&2
    echo "hint: install uv from https://docs.astral.sh/uv/ or set WIRE_UV" >&2
    exit 69
fi

cd "${repo_root}"
exec "${uv_path}" run \
    --quiet \
    --no-project \
    -- \
    "${python_bin}" -m engine.cli "$@"
