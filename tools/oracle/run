#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/../.." && pwd)"

export ORACLE_REPO_ROOT="${repo_root}"
export PYTHONPATH="${script_dir}${PYTHONPATH:+:${PYTHONPATH}}"

pyyaml_requirement="PyYAML>=6.0,<7"
uv_bin="${ORACLE_UV:-uv}"
python_bin="${ORACLE_PYTHON:-python3}"

if ! uv_path="$(command -v "${uv_bin}")"; then
    echo "error: uv is required to run oracle Python tooling" >&2
    echo "hint: install uv from https://docs.astral.sh/uv/ or set ORACLE_UV" >&2
    exit 69
fi

cd "${repo_root}"
exec "${uv_path}" run \
    --quiet \
    --no-project \
    --with "${pyyaml_requirement}" \
    -- \
    "${python_bin}" -m engine.cli "$@"
