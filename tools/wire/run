#!/usr/bin/env python3
"""Command entrypoint for the wire endpoint tool."""

from __future__ import annotations

import os
import sys
from pathlib import Path

WIRE_ROOT = Path(__file__).resolve().parent
REPO_ROOT = WIRE_ROOT.parent.parent

os.environ.setdefault("LIBCRAFTER_REPO_ROOT", str(REPO_ROOT))

for path in (REPO_ROOT, WIRE_ROOT):
    path_text = str(path)
    while path_text in sys.path:
        sys.path.remove(path_text)
    sys.path.insert(0, path_text)

from engine.cli import main


if __name__ == "__main__":
    raise SystemExit(main())
