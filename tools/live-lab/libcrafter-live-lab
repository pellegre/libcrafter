#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/../.." && pwd)"

usage() {
  cat <<'EOF'
usage: libcrafter-live-lab <doctor|create|run|artifact|destroy> --provider <provider> [args...]

Provider can also be set with LIBCRAFTER_LIVE_LAB_PROVIDER.
Local environment values are loaded from ~/.config/libcrafter/live-test.env
or LIBCRAFTER_LIVE_LAB_ENV when the file exists.
EOF
}

load_local_env() {
  local env_file="${LIBCRAFTER_LIVE_LAB_ENV:-$HOME/.config/libcrafter/live-test.env}"

  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    . "$env_file"
    set +a
  fi
}

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 64
fi

command="$1"
shift

case "$command" in
  doctor|create|run|artifact|destroy) ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    echo "error: unknown command '$command'" >&2
    usage >&2
    exit 64
    ;;
esac

load_local_env

provider="${LIBCRAFTER_LIVE_LAB_PROVIDER:-}"
provider_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --provider)
      if [[ $# -lt 2 ]]; then
        echo "error: --provider requires a value" >&2
        exit 64
      fi
      provider="$2"
      shift 2
      ;;
    --provider=*)
      provider="${1#--provider=}"
      shift
      ;;
    --)
      shift
      provider_args+=("$@")
      break
      ;;
    *)
      provider_args+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$provider" ]]; then
  echo "error: provider is required" >&2
  usage >&2
  exit 64
fi

case "$provider" in
  *[!A-Za-z0-9._-]*)
    echo "error: invalid provider name '$provider'" >&2
    exit 64
    ;;
esac

provider_bin="$script_dir/providers/$provider"
if [[ ! -x "$provider_bin" ]]; then
  echo "error: provider '$provider' is not available or not executable" >&2
  exit 69
fi

export LIBCRAFTER_LIVE_LAB_ROOT="$script_dir"
export LIBCRAFTER_PROJECT_ROOT="${LIBCRAFTER_PROJECT_ROOT:-$repo_root}"
export LIBCRAFTER_LIVE_LAB_STATE_DIR="${LIBCRAFTER_LIVE_LAB_STATE_DIR:-$script_dir/.state}"
export LIBCRAFTER_LIVE_LAB_ARTIFACT_DIR="${LIBCRAFTER_LIVE_LAB_ARTIFACT_DIR:-$script_dir/artifacts}"

exec "$provider_bin" "$command" "${provider_args[@]}"
