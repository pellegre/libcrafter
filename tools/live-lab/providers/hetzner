run_create() {
  local dry_run=false
  local name
  local network_name
  local network_id=""
  local key_path
  local public_key
  local user_data
  local payload
  local response
  local hcloud_ssh_key_id=""
  local libcrafter_server_id=""
  local libcrafter_server_name
  local libcrafter_public_ipv4
  local libcrafter_public_ipv6
  local libcrafter_private_mac=""
  local reference_server_id=""
  local reference_server_name
  local reference_public_ipv4
  local reference_public_ipv6
  local reference_private_mac=""

  if has_arg "--dry-run" "$@"; then
    dry_run=true
  fi

  name="$(server_name)"
  network_name="$name-network"
  libcrafter_server_name="$name-libcrafter"
  reference_server_name="$name-reference"

  if [[ "$dry_run" == true ]]; then
    ensure_dirs
    cat >"$artifact_dir/create.dry-run.log" <<EOF
$(timestamp_utc) Hetzner create dry-run completed without infrastructure changes.
topology=two-endpoint-private-network
server_type=${HETZNER_SERVER_TYPE:-cpx11}
image=${HETZNER_IMAGE:-ubuntu-24.04}
location=${HETZNER_LOCATION:-ash}
network_name=$network_name
network_ip_range=$private_network_cidr
network_zone=$private_network_zone
private_interface=$private_interface
libcrafter_server_name=$libcrafter_server_name
libcrafter_private_ipv4=$libcrafter_private_ipv4
reference_server_name=$reference_server_name
reference_private_ipv4=$reference_private_ipv4
token_configured=$([[ -n "${HETZNER_API_TOKEN:-}" ]] && echo true || echo false)
EOF
    echo "provider=$provider_name"
    echo "created=false"
    echo "dry_run=true"
    echo "creates_infrastructure=false"
    echo "would_create_two_endpoint_lab=true"
    echo "would_create_network=$network_name"
    echo "network_ip_range=$private_network_cidr"
    echo "network_zone=$private_network_zone"
    echo "endpoint_count=2"
    echo "libcrafter_endpoint=$libcrafter_server_name"
    echo "libcrafter_private_ipv4=$libcrafter_private_ipv4"
    echo "reference_endpoint=$reference_server_name"
    echo "reference_private_ipv4=$reference_private_ipv4"
    echo "private_interface=$private_interface"
    echo "ssh_key=shared"
    echo "log=$artifact_dir/create.dry-run.log"
    return 0
  fi

  require_tool curl
  require_tool jq
  require_tool ssh
  require_tool ssh-keygen
  require_token
  require_live_confirmation
  ensure_dirs

  key_path="$(ensure_ssh_key)"
  public_key="$(<"$key_path.pub")"
  if ! hcloud_ssh_key_id="$(create_ssh_key "$name" "$public_key")"; then
    exit 70
  fi
  user_data="$(cloud_init_for_key "$public_key")"
  ssh_private_key="$key_path"
  ssh_user="${HETZNER_SSH_USER:-root}"

  log "creating Hetzner private network $network_name"
  if ! network_id="$(create_network "$network_name")"; then
    cleanup_partial_create "" "$hcloud_ssh_key_id"
    exit 70
  fi
  if ! add_network_subnet "$network_id"; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id"
    exit 70
  fi

  payload="$(create_payload "$libcrafter_server_name" "$user_data" "$hcloud_ssh_key_id" "libcrafter")"
  log "creating Hetzner libcrafter endpoint $libcrafter_server_name"
  if ! response="$(api POST "/servers" "$payload")"; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id"
    exit 70
  fi
  libcrafter_server_id="$(jq -r '.server.id // empty' <<<"$response")"
  libcrafter_public_ipv4="$(jq -r '.server.public_net.ipv4.ip // empty' <<<"$response")"
  libcrafter_public_ipv6="$(jq -r '.server.public_net.ipv6.ip // empty' <<<"$response")"

  if [[ -z "$libcrafter_server_id" || "$libcrafter_server_id" == "null" ]]; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id"
    echo "error: Hetzner libcrafter endpoint response did not include a server id" >&2
    exit 70
  fi

  payload="$(create_payload "$reference_server_name" "$user_data" "$hcloud_ssh_key_id" "reference_backend")"
  log "creating Hetzner reference endpoint $reference_server_name"
  if ! response="$(api POST "/servers" "$payload")"; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id" "$libcrafter_server_id"
    exit 70
  fi
  reference_server_id="$(jq -r '.server.id // empty' <<<"$response")"
  reference_public_ipv4="$(jq -r '.server.public_net.ipv4.ip // empty' <<<"$response")"
  reference_public_ipv6="$(jq -r '.server.public_net.ipv6.ip // empty' <<<"$response")"

  if [[ -z "$reference_server_id" || "$reference_server_id" == "null" ]]; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id" "$libcrafter_server_id"
    echo "error: Hetzner reference endpoint response did not include a server id" >&2
    exit 70
  fi

  if ! wait_for_server_running "$libcrafter_server_id"; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id" "$libcrafter_server_id" "$reference_server_id"
    exit 75
  fi
  if ! wait_for_server_running "$reference_server_id"; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id" "$libcrafter_server_id" "$reference_server_id"
    exit 75
  fi

  if ! attach_server_to_network "$libcrafter_server_id" "$network_id" "$libcrafter_private_ipv4"; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id" "$libcrafter_server_id" "$reference_server_id"
    exit 70
  fi
  if ! attach_server_to_network "$reference_server_id" "$network_id" "$reference_private_ipv4"; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id" "$libcrafter_server_id" "$reference_server_id"
    exit 70
  fi

  forget_known_host "$libcrafter_public_ipv4"
  forget_known_host "$reference_public_ipv4"

  if ! wait_for_ssh "$libcrafter_public_ipv4"; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id" "$libcrafter_server_id" "$reference_server_id"
    exit 75
  fi
  if ! wait_for_ssh "$reference_public_ipv4"; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id" "$libcrafter_server_id" "$reference_server_id"
    exit 75
  fi
  if ! configure_private_interface "$libcrafter_public_ipv4" "$libcrafter_private_ipv4"; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id" "$libcrafter_server_id" "$reference_server_id"
    exit 75
  fi
  if ! configure_private_interface "$reference_public_ipv4" "$reference_private_ipv4"; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id" "$libcrafter_server_id" "$reference_server_id"
    exit 75
  fi
  if ! libcrafter_private_mac="$(read_interface_mac "$libcrafter_public_ipv4" "$private_interface")"; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id" "$libcrafter_server_id" "$reference_server_id"
    exit 75
  fi
  if ! reference_private_mac="$(read_interface_mac "$reference_public_ipv4" "$private_interface")"; then
    cleanup_partial_create "$network_id" "$hcloud_ssh_key_id" "$libcrafter_server_id" "$reference_server_id"
    exit 75
  fi

  write_manifest \
    "$name" \
    "$network_id" \
    "$network_name" \
    "$key_path" \
    "$hcloud_ssh_key_id" \
    "$libcrafter_server_id" \
    "$libcrafter_server_name" \
    "$libcrafter_public_ipv4" \
    "$libcrafter_public_ipv6" \
    "$reference_server_id" \
    "$reference_server_name" \
    "$reference_public_ipv4" \
    "$reference_public_ipv6" \
    "$libcrafter_private_mac" \
    "$reference_private_mac"

  cat >"$artifact_dir/create.log" <<EOF
$(timestamp_utc) Hetzner two-endpoint private-network lab created.
provider=$provider_name
lab_name=$name
network_id=$network_id
network_name=$network_name
libcrafter_server_id=$libcrafter_server_id
libcrafter_server_name=$libcrafter_server_name
libcrafter_public_ipv4=$libcrafter_public_ipv4
libcrafter_private_ipv4=$libcrafter_private_ipv4
libcrafter_private_mac=$libcrafter_private_mac
reference_server_id=$reference_server_id
reference_server_name=$reference_server_name
reference_public_ipv4=$reference_public_ipv4
reference_private_ipv4=$reference_private_ipv4
reference_private_mac=$reference_private_mac
EOF

  echo "provider=$provider_name"
  echo "created=true"
  echo "lab_name=$name"
  echo "network_id=$network_id"
  echo "network_name=$network_name"
  echo "endpoint_count=2"
  echo "libcrafter_server_id=$libcrafter_server_id"
  echo "libcrafter_public_ipv4=$libcrafter_public_ipv4"
  echo "libcrafter_private_ipv4=$libcrafter_private_ipv4"
  echo "reference_server_id=$reference_server_id"
  echo "reference_public_ipv4=$reference_public_ipv4"
  echo "reference_private_ipv4=$reference_private_ipv4"
  echo "manifest=$manifest"
}

run_remote_validation() {
  local command_string
  local quoted_command
  local remote_dir_value
  local examples_source
  local remote_examples_dir
  local tar_args

  load_manifest
  require_tool ssh
  require_tool scp
  require_tool tar

  remote_dir_value="${remote_dir:-/root/libcrafter}"
  case "$remote_dir_value" in
    /*) ;;
    *)
      echo "error: remote_dir must be an absolute path" >&2
      exit 64
      ;;
  esac
  case "$remote_dir_value" in
    *"'"*)
      echo "error: remote_dir must not contain single quotes" >&2
      exit 64
      ;;
  esac
  mkdir -p "$artifact_dir"

  wait_for_ssh
  ssh_remote "rm -rf '$remote_dir_value' && mkdir -p '$remote_dir_value' '$remote_dir_value/live-artifacts'"

  tar_args=(
    --exclude=.git
    --exclude=target
    --exclude=tools/live-lab/.state
    --exclude=tools/live-lab/artifacts
    -czf -
    .
  )

  tar -C "$project_root" "${tar_args[@]}" | ssh_remote "tar -xzf - -C '$remote_dir_value'"

  if [[ $# -gt 0 ]]; then
    printf -v command_string '%q ' "$@"
    printf -v quoted_command '%q' "$command_string"
    ssh_remote "cd '$remote_dir_value' && bash -lc $quoted_command" \
      | tee "$artifact_dir/run.log"
  else
    default_remote_command \
      | ssh_remote "cat > '$remote_dir_value/run-live-validation.sh' && chmod +x '$remote_dir_value/run-live-validation.sh'"
    ssh_remote "cd '$remote_dir_value' && bash ./run-live-validation.sh" \
      | tee "$artifact_dir/run.log"
  fi

  echo "provider=$provider_name"
  echo "ran=true"
  echo "server_id=$server_id"
  echo "log=$artifact_dir/run.log"
}

cleanup_hetzner_smoke_host() {
  local exit_status=$?

  if [[ "${hetzner_smoke_cleanup_needed:-false}" == true && -f "$manifest" ]]; then
    run_destroy || true
  fi

  trap - EXIT
  exit "$exit_status"
}

run_oracle_live_suite() {
  local requested_suite="${1:-oracle-live}"
  local oracle_artifact_dir="$artifact_dir/$requested_suite"
  local dry_run=false
  local created_for_oracle=false
  local suite_status=0

  shift || true
  if has_arg "--dry-run" "$@"; then
    dry_run=true
  fi

  ensure_dirs
  mkdir -p "$oracle_artifact_dir"
  run_doctor --dry-run | tee "$oracle_artifact_dir/doctor.dry-run.log"
  run_create --dry-run | tee "$oracle_artifact_dir/create.dry-run.log"

  if [[ "$dry_run" == true ]]; then
    write_bootstrap_dry_run_artifacts "$oracle_artifact_dir"
  else
    if [[ -z "${HETZNER_API_TOKEN:-}" ]]; then
      write_bootstrap_dry_run_artifacts "$oracle_artifact_dir"
      cat >"$oracle_artifact_dir/skipped.env" <<EOF
suite=$requested_suite
result=skipped
reason=no_token
finished_at=$(timestamp_utc)
EOF
      echo "provider=$provider_name"
      echo "ran=false"
      echo "suite=$requested_suite"
      echo "suite_kind=oracle-live-validation"
      echo "skipped=true"
      echo "reason=no_token"
      echo "creates_infrastructure=false"
      echo "artifact_dir=$oracle_artifact_dir"
      return 0
    fi

    if [[ ! -f "$manifest" ]]; then
      created_for_oracle=true
      hetzner_smoke_cleanup_needed=true
      trap cleanup_hetzner_smoke_host EXIT
      run_create
    fi

    if bootstrap_live_endpoints "$oracle_artifact_dir"; then
      suite_status=0
    else
      suite_status=$?
    fi
  fi

  "$project_root/tools/oracle/run" live \
    --backend scapy \
    --provider hetzner \
    --profile smoke \
    --seed 1 \
    --count 10 \
    --dry-run \
    --out "$oracle_artifact_dir" \
    | tee "$artifact_dir/$requested_suite.log"

  if [[ -f "$manifest" ]]; then
    run_artifact || true
  fi

  if [[ "$created_for_oracle" == true ]]; then
    run_destroy || true
    hetzner_smoke_cleanup_needed=false
    trap - EXIT
  fi

  echo "provider=$provider_name"
  echo "ran=true"
  echo "suite=$requested_suite"
  echo "suite_kind=oracle-live-validation"
  echo "live_packet_tests=false"
  echo "creates_infrastructure=false"
  echo "artifact_dir=$oracle_artifact_dir"
  echo "log=$artifact_dir/$requested_suite.log"
  echo "bootstrap_libcrafter_endpoint=$oracle_artifact_dir/bootstrap/libcrafter"
  echo "bootstrap_reference_endpoint=$oracle_artifact_dir/bootstrap/reference"

  return "$suite_status"
}

run_artifact() {
  load_manifest
  mkdir -p "$artifact_dir"

  if [[ -n "${ssh_private_key:-}" ]]; then
    if [[ -n "${libcrafter_public_ipv4:-}" ]]; then
      if ssh_remote_host "$libcrafter_public_ipv4" "test -d '${remote_dir:-/root/libcrafter}/live-artifacts'" >/dev/null 2>&1; then
        rm -rf "$artifact_dir/remote/libcrafter"
        mkdir -p "$artifact_dir/remote/libcrafter"
        scp_from_remote_host "$libcrafter_public_ipv4" "${remote_dir:-/root/libcrafter}/live-artifacts/." "$artifact_dir/remote/libcrafter/" || true
      fi
    elif [[ -n "${server_ipv4:-}" ]]; then
      if ssh_remote "test -d '${remote_dir:-/root/libcrafter}/live-artifacts'" >/dev/null 2>&1; then
        rm -rf "$artifact_dir/remote"
        mkdir -p "$artifact_dir/remote"
        scp_from_remote "${remote_dir:-/root/libcrafter}/live-artifacts/." "$artifact_dir/remote/" || true
      fi
    fi

    if [[ -n "${reference_public_ipv4:-}" ]]; then
      if ssh_remote_host "$reference_public_ipv4" "test -d '${remote_dir:-/root/libcrafter}/live-artifacts'" >/dev/null 2>&1; then
        rm -rf "$artifact_dir/remote/reference"
        mkdir -p "$artifact_dir/remote/reference"
        scp_from_remote_host "$reference_public_ipv4" "${remote_dir:-/root/libcrafter}/live-artifacts/." "$artifact_dir/remote/reference/" || true
      fi
    fi
  fi

  echo "provider=$provider_name"
  echo "artifact_dir=$artifact_dir"
  find "$artifact_dir" -type f -print | sort
}

run_destroy() {
  local server_ids=()
  local server_id_value
  local network_id_value
  local ssh_key_id_value
  local attempt

  if [[ ! -f "$manifest" ]]; then
    mkdir -p "$artifact_dir"
    cat >"$artifact_dir/destroy.log" <<EOF
$(timestamp_utc) Hetzner destroy completed with no manifest present.
EOF
    echo "provider=$provider_name"
    echo "destroyed=false"
    echo "reason=no_manifest"
    return 0
  fi

  load_manifest
  require_tool curl
  require_token

  if [[ -n "${cleanup_server_ids:-}" ]]; then
    read -r -a server_ids <<<"$cleanup_server_ids"
  elif [[ -n "${server_id:-}" ]]; then
    server_ids=("$server_id")
  fi

  for server_id_value in "${server_ids[@]}"; do
    if [[ -n "$server_id_value" && "$server_id_value" != "null" ]]; then
      log "destroying Hetzner server $server_id_value"
      api DELETE "/servers/$server_id_value" >/dev/null || true
    fi
  done

  network_id_value="${cleanup_network_id:-${network_id:-}}"
  if [[ -n "$network_id_value" && "$network_id_value" != "null" ]]; then
    for attempt in $(seq 1 20); do
      if api DELETE "/networks/$network_id_value" >/dev/null 2>&1; then
        break
      fi
      sleep 3
    done
  fi

  ssh_key_id_value="${cleanup_ssh_key_id:-${hcloud_ssh_key_id:-}}"
  if [[ -n "$ssh_key_id_value" && "$ssh_key_id_value" != "null" ]]; then
    api DELETE "/ssh_keys/$ssh_key_id_value" >/dev/null || true
  fi

  mkdir -p "$artifact_dir"
  cat >"$artifact_dir/destroy.log" <<EOF
$(timestamp_utc) Hetzner destroy requested.
provider=$provider_name
lab_name=${lab_name:-}
server_ids=${cleanup_server_ids:-${server_id:-}}
network_id=${network_id_value:-}
ssh_key_id=${ssh_key_id_value:-}
EOF

  rm -rf "$state_dir"

  echo "provider=$provider_name"
  echo "destroyed=true"
}

load_provider_env

case "$command" in
  doctor)
    run_doctor "$@"
    ;;

  create)
    run_create "$@"
    ;;

  run)
    suite="$(suite_arg "$@")"
    if [[ -n "$suite" ]]; then
      case "$suite" in
        oracle-live)
          run_oracle_live_suite "$suite" "$@"
          ;;
        *)
          echo "error: unknown Hetzner suite '$suite'" >&2
          exit 64
          ;;
      esac
    else
      run_remote_validation "$@"
    fi
    ;;

  artifact)
    run_artifact "$@"
    ;;

  destroy)
    run_destroy "$@"
    ;;

  *)
    echo "error: unknown Hetzner command '$command'" >&2
    exit 64
    ;;
esac
