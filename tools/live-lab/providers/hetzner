    if [[ ! -f "$manifest" ]]; then
      created_for_oracle=true
      if [[ "$keep_live_lab" != true ]]; then
        hetzner_smoke_cleanup_needed=true
        trap cleanup_hetzner_smoke_host EXIT
      fi
      run_create
    fi

    if bootstrap_live_endpoints "$oracle_artifact_dir"; then
      suite_status=0
    else
      suite_status=$?
    fi
  fi

  oracle_args=(
    live
    --provider hetzner
    --profile "$profile"
    --seed "$seed"
    --count "$count"
    --direction "$direction"
    --dry-run
    --out "$oracle_artifact_dir"
  )
  if [[ -n "$backend" ]]; then
    oracle_args+=(--backend "$backend")
  fi
  if [[ -n "$preserved_corpus_path" ]]; then
    oracle_args+=(--corpus "$preserved_corpus_path")
  fi
  oracle_args+=("${generation_args[@]}")

  if "$project_root/tools/oracle/run" "${oracle_args[@]}" | tee "$artifact_dir/$requested_suite.log"; then
    :
  else
    suite_status=$?
  fi

  if [[ -f "$manifest" ]]; then
    run_artifact || true
  fi

  if [[ "$created_for_oracle" == true ]]; then
    if [[ "$keep_live_lab" == true ]]; then
      echo "keep_live_lab=true"
    else
      run_destroy || true
      hetzner_smoke_cleanup_needed=false
      trap - EXIT
    fi
  fi

  echo "provider=$provider_name"
  echo "ran=true"
  echo "suite=$requested_suite"
  echo "suite_kind=oracle-live-validation"
  echo "live_packet_tests=false"
  echo "creates_infrastructure=false"
  echo "artifact_dir=$oracle_artifact_dir"
  echo "log=$artifact_dir/$requested_suite.log"
  if [[ -n "$preserved_corpus_path" ]]; then
    echo "corpus_artifact=$preserved_corpus_path"
  fi
  echo "bootstrap_libcrafter_endpoint=$oracle_artifact_dir/bootstrap/libcrafter"
  echo "bootstrap_reference_endpoint=$oracle_artifact_dir/bootstrap/reference"
  echo "capability_report=$oracle_artifact_dir/capabilities.json"

  return "$suite_status"
}

