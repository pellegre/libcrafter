write_bootstrap_dry_run_artifacts() {
  local oracle_artifact_dir="$1"
  local bootstrap_dir="$oracle_artifact_dir/bootstrap"

  mkdir -p "$bootstrap_dir/libcrafter" "$bootstrap_dir/reference"
  cat >"$bootstrap_dir/libcrafter/bootstrap.dry-run.env" <<EOF
role=libcrafter
dry_run=true
repository_sync=planned
private_ipv4=$libcrafter_private_ipv4
system_packages=build-essential ca-certificates clang curl git iproute2 libpcap-dev pkg-config python3
python_dependency_runner=uv
uv_install=if-missing
rust_install=if-missing
validation=cargo build -p crafter --example oracle_live_endpoint
artifact=live-artifacts/bootstrap/libcrafter/bootstrap.env
EOF
  cat >"$bootstrap_dir/reference/bootstrap.dry-run.env" <<EOF
role=reference_backend
dry_run=true
repository_sync=planned
private_ipv4=$reference_private_ipv4
system_packages=ca-certificates curl git iproute2 python3
python_dependency_runner=uv
uv_install=if-missing
scapy_validation=tools/oracle/run backend-info --backend scapy
tshark_availability=reported_optional_not_required
artifact=live-artifacts/bootstrap/reference_backend/bootstrap.env
EOF
}

bootstrap_live_endpoints() {
  local oracle_artifact_dir="$1"
  local remote_dir_value="${remote_dir:-/root/libcrafter}"
  local suite_bootstrap_dir="$oracle_artifact_dir/bootstrap"
  local libcrafter_script
  local reference_script

  load_manifest
  require_tool ssh
  require_tool tar

  validate_remote_dir "$remote_dir_value"
  if [[ -z "${libcrafter_public_ipv4:-}" || -z "${reference_public_ipv4:-}" ]]; then
    echo "error: Hetzner manifest must include both libcrafter and reference endpoint hosts" >&2
    exit 66
  fi

  mkdir -p "$suite_bootstrap_dir/libcrafter" "$suite_bootstrap_dir/reference"

  log "syncing repository to Hetzner libcrafter endpoint $libcrafter_public_ipv4"
  sync_repo_to_endpoint "libcrafter" "$libcrafter_public_ipv4" "$remote_dir_value"
  log "syncing repository to Hetzner reference endpoint $reference_public_ipv4"
  sync_repo_to_endpoint "reference_backend" "$reference_public_ipv4" "$remote_dir_value"

  libcrafter_script="$(libcrafter_bootstrap_script)"
  reference_script="$(reference_bootstrap_script)"

  log "bootstrapping Hetzner libcrafter endpoint"
  run_endpoint_script "libcrafter" "$libcrafter_public_ipv4" "$libcrafter_private_ipv4" "$remote_dir_value" "$libcrafter_script" \
    | tee "$suite_bootstrap_dir/libcrafter/bootstrap.log"
  log "bootstrapping Hetzner reference endpoint"
  run_endpoint_script "reference_backend" "$reference_public_ipv4" "$reference_private_ipv4" "$remote_dir_value" "$reference_script" \
    | tee "$suite_bootstrap_dir/reference/bootstrap.log"

  echo "provider=$provider_name"
  echo "bootstrap=true"
  echo "libcrafter_bootstrap_artifact=$suite_bootstrap_dir/libcrafter/bootstrap.log"
  echo "reference_bootstrap_artifact=$suite_bootstrap_dir/reference/bootstrap.log"
}

default_remote_command() {
  cat <<'EOF'
set -euo pipefail
cd "$HOME/libcrafter"
if ! command -v cargo >/dev/null 2>&1; then
  curl -fsS https://sh.rustup.rs | sh -s -- -y
fi
if ! command -v uv >/dev/null 2>&1; then
  curl -LsSf https://astral.sh/uv/install.sh | sh
fi
export PATH="$HOME/.local/bin:$PATH"
. "$HOME/.cargo/env"
cargo test --workspace
tools/oracle/run backend-info --backend scapy >/dev/null
echo "reference_backend=ok"
EOF
}

create_payload() {
  local name="$1"
  local user_data="$2"
  local hcloud_ssh_key_id="$3"
  local role="${4:-endpoint}"
  local server_type="${HETZNER_SERVER_TYPE:-cpx11}"
  local image="${HETZNER_IMAGE:-ubuntu-24.04}"
  local location="${HETZNER_LOCATION:-ash}"

  jq -n \
    --arg name "$name" \
    --arg role "$role" \
    --arg server_type "$server_type" \
    --arg image "$image" \
    --arg location "$location" \
    --arg user_data "$user_data" \
    --argjson hcloud_ssh_key_id "$hcloud_ssh_key_id" \
    '{
      name: $name,
      server_type: $server_type,
      image: $image,
      location: $location,
      public_net: { enable_ipv4: true, enable_ipv6: true },
      ssh_keys: [$hcloud_ssh_key_id],
      user_data: $user_data,
      labels: {
        project: "libcrafter",
        purpose: "live-lab",
        provider: "hetzner",
        role: $role,
        topology: "two-endpoint-private"
      }
    }'
}

