mkdir -p "live-artifacts/bootstrap/$LIBCRAFTER_ENDPOINT_ROLE"
tools/oracle/run backend-info \
  > "live-artifacts/bootstrap/$LIBCRAFTER_ENDPOINT_ROLE/reference-backend.json"
