#!/usr/bin/env bash
set -euo pipefail

command="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

provider_name="hetzner"
state_root="${LIBCRAFTER_LIVE_LAB_STATE_DIR:?LIBCRAFTER_LIVE_LAB_STATE_DIR is required}"
artifact_root="${LIBCRAFTER_LIVE_LAB_ARTIFACT_DIR:?LIBCRAFTER_LIVE_LAB_ARTIFACT_DIR is required}"
project_root="${LIBCRAFTER_PROJECT_ROOT:?LIBCRAFTER_PROJECT_ROOT is required}"

state_dir="$state_root/$provider_name"
artifact_dir="$artifact_root/$provider_name"
manifest="$state_dir/manifest.env"
api_base="${HETZNER_API_BASE:-https://api.hetzner.cloud/v1}"
hetzner_smoke_cleanup_needed=false
private_network_cidr="${HETZNER_PRIVATE_NETWORK_CIDR:-10.42.19.0/24}"
private_network_zone="${HETZNER_NETWORK_ZONE:-us-east}"
private_interface_override="${HETZNER_PRIVATE_INTERFACE:-}"
private_interface="${private_interface_override:-auto}"
private_prefix_len="${HETZNER_PRIVATE_PREFIX_LEN:-24}"
libcrafter_private_ipv4="${HETZNER_LIBCRAFTER_PRIVATE_IPV4:-10.42.19.10}"
reference_private_ipv4="${HETZNER_REFERENCE_PRIVATE_IPV4:-10.42.19.20}"

timestamp_utc() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

log() {
  printf '%s %s\n' "$(timestamp_utc)" "$*" >&2
}

load_provider_env() {
  local env_file="${LIBCRAFTER_LIVE_LAB_ENV:-$HOME/.config/libcrafter/live-test.env}"

  if [[ -z "${HETZNER_API_TOKEN:-}" && -f "$env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    . "$env_file"
    set +a
  fi
}

has_arg() {
  local needle="$1"
  shift

  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "$needle" ]]; then
      return 0
    fi
    shift
  done

  return 1
}

suite_arg() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --suite)
        if [[ $# -lt 2 ]]; then
          echo "error: --suite requires a value" >&2
          exit 64
        fi
        printf '%s\n' "$2"
        return 0
        ;;
      --suite=*)
        printf '%s\n' "${1#--suite=}"
        return 0
        ;;
    esac
    shift
  done
}

require_tool() {
  local tool="$1"

  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "error: required tool '$tool' is not installed" >&2
    exit 69
  fi
}

require_token() {
  if [[ -z "${HETZNER_API_TOKEN:-}" ]]; then
    echo "error: HETZNER_API_TOKEN is required for non-dry-run Hetzner operations" >&2
    exit 78
  fi
}

require_live_confirmation() {
  local confirmation="${LIBCRAFTER_ORACLE_LIVE_CONFIRM:-${LIBCRAFTER_LIVE_LAB_CONFIRM:-${CONFIRM_LIVE_LAB:-}}}"

  if [[ "$confirmation" != "run" ]]; then
    echo "error: non-dry-run Hetzner create requires explicit confirmation from the oracle live command path" >&2
    echo "hint: set LIBCRAFTER_LIVE_LAB_CONFIRM=run only for the intended disposable live run" >&2
    exit 78
  fi
}

ensure_dirs() {
  mkdir -p "$state_dir" "$artifact_dir"
}

write_manifest() {
  local lab_name="$1"
  local network_id="$2"
  local network_name="$3"
  local ssh_key="$4"
  local hcloud_ssh_key_id="$5"
  local libcrafter_server_id="$6"
  local libcrafter_server_name="$7"
  local libcrafter_public_ipv4="$8"
  local libcrafter_public_ipv6="$9"
  local reference_server_id="${10}"
  local reference_server_name="${11}"
  local reference_public_ipv4="${12}"
  local reference_public_ipv6="${13}"
  local libcrafter_private_mac="${14}"
  local reference_private_mac="${15}"

  ensure_dirs
  {
    printf 'provider=%q\n' "$provider_name"
    printf 'created_at=%q\n' "$(timestamp_utc)"
    printf 'resource_type=%q\n' "hetzner-two-endpoint-private-network-lab"
    printf 'lab_name=%q\n' "$lab_name"
    printf 'network_id=%q\n' "$network_id"
    printf 'network_name=%q\n' "$network_name"
    printf 'network_ip_range=%q\n' "$private_network_cidr"
    printf 'network_zone=%q\n' "$private_network_zone"
    printf 'private_interface=%q\n' "$private_interface"
    printf 'endpoint_count=%q\n' "2"
    printf 'libcrafter_role=%q\n' "libcrafter"
    printf 'libcrafter_server_id=%q\n' "$libcrafter_server_id"
    printf 'libcrafter_server_name=%q\n' "$libcrafter_server_name"
    printf 'libcrafter_public_ipv4=%q\n' "$libcrafter_public_ipv4"
    printf 'libcrafter_public_ipv6=%q\n' "$libcrafter_public_ipv6"
    printf 'libcrafter_ssh_host=%q\n' "$libcrafter_public_ipv4"
    printf 'libcrafter_ssh_address=%q\n' "${HETZNER_SSH_USER:-root}@$libcrafter_public_ipv4"
    printf 'libcrafter_private_ipv4=%q\n' "$libcrafter_private_ipv4"
    printf 'libcrafter_private_mac=%q\n' "$libcrafter_private_mac"
    printf 'libcrafter_interface=%q\n' "$private_interface"
    printf 'reference_role=%q\n' "reference_backend"
    printf 'reference_server_id=%q\n' "$reference_server_id"
    printf 'reference_server_name=%q\n' "$reference_server_name"
    printf 'reference_public_ipv4=%q\n' "$reference_public_ipv4"
    printf 'reference_public_ipv6=%q\n' "$reference_public_ipv6"
    printf 'reference_ssh_host=%q\n' "$reference_public_ipv4"
    printf 'reference_ssh_address=%q\n' "${HETZNER_SSH_USER:-root}@$reference_public_ipv4"
    printf 'reference_private_ipv4=%q\n' "$reference_private_ipv4"
    printf 'reference_private_mac=%q\n' "$reference_private_mac"
    printf 'reference_interface=%q\n' "$private_interface"
    printf 'cleanup_server_ids=%q\n' "$libcrafter_server_id $reference_server_id"
    printf 'cleanup_network_id=%q\n' "$network_id"
    printf 'cleanup_ssh_key_id=%q\n' "$hcloud_ssh_key_id"
    printf 'server_id=%q\n' "$libcrafter_server_id"
    printf 'server_name=%q\n' "$libcrafter_server_name"
    printf 'server_ipv4=%q\n' "$libcrafter_public_ipv4"
    printf 'server_ipv6=%q\n' "$libcrafter_public_ipv6"
    printf 'ssh_user=%q\n' "${HETZNER_SSH_USER:-root}"
    printf 'ssh_private_key=%q\n' "$ssh_key"
    printf 'hcloud_ssh_key_id=%q\n' "$hcloud_ssh_key_id"
    printf 'remote_dir=%q\n' "${LIBCRAFTER_LIVE_LAB_REMOTE_DIR:-/root/libcrafter}"
    printf 'artifact_dir=%q\n' "$artifact_dir"
    printf 'status=%q\n' "created"
  } >"$manifest"
  chmod 600 "$manifest"
}

load_manifest() {
  if [[ ! -f "$manifest" ]]; then
    echo "error: no Hetzner live-lab manifest found at $manifest" >&2
    exit 66
  fi

  # shellcheck disable=SC1090
  . "$manifest"
}

api() {
  local method="$1"
  local path="$2"
  local body="${3:-}"

  require_token

  if [[ -n "$body" ]]; then
    curl -fsS \
      -X "$method" \
      -H "Authorization: Bearer $HETZNER_API_TOKEN" \
      -H "Content-Type: application/json" \
      --data "$body" \
      "$api_base$path"
  else
    curl -fsS \
      -X "$method" \
      -H "Authorization: Bearer $HETZNER_API_TOKEN" \
      "$api_base$path"
  fi
}

wait_for_action() {
  local action_id="$1"
  local attempt
  local status
  local error_message

  if [[ -z "$action_id" || "$action_id" == "null" ]]; then
    return 0
  fi

  for attempt in $(seq 1 60); do
    status="$(api GET "/actions/$action_id" | jq -r '.action.status // empty')"
    case "$status" in
      success)
        return 0
        ;;
      error)
        error_message="$(api GET "/actions/$action_id" | jq -r '.action.error.message // "unknown error"')"
        echo "error: Hetzner action $action_id failed: $error_message" >&2
        return 70
        ;;
    esac
    sleep 3
  done

  echo "error: Hetzner action $action_id did not finish in time" >&2
  return 75
}

create_network() {
  local name="$1"
  local payload
  local response
  local network_id

  payload="$(jq -n \
    --arg name "$name" \
    --arg ip_range "$private_network_cidr" \
    '{
      name: $name,
      ip_range: $ip_range,
      labels: {
        project: "libcrafter",
        purpose: "live-lab",
        provider: "hetzner",
        topology: "two-endpoint-private"
      }
    }')"

  response="$(api POST "/networks" "$payload")"
  network_id="$(jq -r '.network.id // empty' <<<"$response")"

  if [[ -z "$network_id" || "$network_id" == "null" ]]; then
    echo "error: Hetzner network response did not include a network id" >&2
    return 70
  fi

  printf '%s\n' "$network_id"
}

add_network_subnet() {
  local network_id="$1"
  local payload
  local response
  local action_id

  payload="$(jq -n \
    --arg network_zone "$private_network_zone" \
    --arg ip_range "$private_network_cidr" \
    '{
      type: "cloud",
      network_zone: $network_zone,
      ip_range: $ip_range
    }')"

  response="$(api POST "/networks/$network_id/actions/add_subnet" "$payload")"
  action_id="$(jq -r '.action.id // empty' <<<"$response")"
  wait_for_action "$action_id"
}

attach_server_to_network() {
  local server_id="$1"
  local network_id="$2"
  local private_ip="$3"
  local payload
  local response
  local action_id

  payload="$(jq -n \
    --argjson network "$network_id" \
    --arg ip "$private_ip" \
    '{
      network: $network,
      ip: $ip
    }')"

  response="$(api POST "/servers/$server_id/actions/attach_to_network" "$payload")"
  action_id="$(jq -r '.action.id // empty' <<<"$response")"
  wait_for_action "$action_id"
}

cleanup_partial_create() {
  local network_id="${1:-}"
  local hcloud_ssh_key_id="${2:-}"
  shift 2 || true
  local server_id

  for server_id in "$@"; do
    if [[ -n "$server_id" && "$server_id" != "null" ]]; then
      api DELETE "/servers/$server_id" >/dev/null || true
    fi
  done

  if [[ -n "$network_id" && "$network_id" != "null" ]]; then
    api DELETE "/networks/$network_id" >/dev/null || true
  fi
  if [[ -n "$hcloud_ssh_key_id" && "$hcloud_ssh_key_id" != "null" ]]; then
    api DELETE "/ssh_keys/$hcloud_ssh_key_id" >/dev/null || true
  fi
}

server_name() {
  local prefix="${HETZNER_SERVER_NAME_PREFIX:-libcrafter-live-lab}"
  printf '%s-%s' "$prefix" "$(date -u +%Y%m%d%H%M%S)"
}

ensure_ssh_key() {
  local key_path="$state_dir/id_ed25519"

  ensure_dirs
  if [[ ! -f "$key_path" ]]; then
    umask 077
    ssh-keygen -q -t ed25519 -N "" -C "libcrafter-live-lab@$provider_name" -f "$key_path"
  fi

  printf '%s\n' "$key_path"
}

cloud_init_for_key() {
  local public_key="$1"

  cat <<EOF
#cloud-config
disable_root: false
users:
  - name: root
    lock_passwd: true
    shell: /bin/bash
    ssh_authorized_keys:
      - $public_key
ssh_pwauth: false
package_update: true
packages:
  - ca-certificates
  - curl
  - git
  - iproute2
  - build-essential
  - clang
  - pkg-config
  - libpcap-dev
  - python3
runcmd:
  - [ sh, -c, "curl -LsSf https://astral.sh/uv/install.sh | sh" ]
  - [ sh, -c, "ln -sf /root/.local/bin/uv /usr/local/bin/uv" ]
EOF
}

create_ssh_key() {
  local key_name="$1"
  local public_key="$2"
  local payload
  local response
  local key_id

  payload="$(jq -n \
    --arg name "$key_name" \
    --arg public_key "$public_key" \
    '{
      name: $name,
      public_key: $public_key,
      labels: {
        project: "libcrafter",
        purpose: "live-lab",
        provider: "hetzner"
      }
    }')"

  response="$(api POST "/ssh_keys" "$payload")"
  key_id="$(jq -r '.ssh_key.id // empty' <<<"$response")"

  if [[ -z "$key_id" || "$key_id" == "null" ]]; then
    echo "error: Hetzner SSH key response did not include a key id" >&2
    return 70
  fi

  printf '%s\n' "$key_id"
}

ssh_options() {
  printf '%s\n' \
    -i "${ssh_private_key:?ssh_private_key is missing}" \
    -o StrictHostKeyChecking=accept-new \
    -o UserKnownHostsFile="$state_dir/known_hosts" \
    -o ConnectTimeout=10
}

ssh_remote_host() {
  local host="$1"
  shift
  local remote="${ssh_user:?ssh_user is missing}@$host"
  ssh $(ssh_options) "$remote" "$@"
}

ssh_remote() {
  local host="${server_ipv4:-${libcrafter_public_ipv4:-}}"

  if [[ -z "$host" ]]; then
    echo "error: no default Hetzner SSH host is available" >&2
    exit 66
  fi

  ssh_remote_host "$host" "$@"
}

forget_known_host() {
  local host="$1"
  local known_hosts="$state_dir/known_hosts"

  if [[ -f "$known_hosts" ]]; then
    ssh-keygen -f "$known_hosts" -R "$host" >/dev/null 2>&1 || true
    rm -f "$known_hosts.old"
  fi
}

scp_from_remote_host() {
  local host="$1"
  local remote_path="$2"
  local local_path="$3"
  local remote="${ssh_user:?ssh_user is missing}@$host"
  scp $(ssh_options) -r "$remote:$remote_path" "$local_path"
}

scp_from_remote() {
  local remote_path="$1"
  local local_path="$2"
  local host="${server_ipv4:-${libcrafter_public_ipv4:-}}"

  if [[ -z "$host" ]]; then
    echo "error: no default Hetzner SCP host is available" >&2
    exit 66
  fi

  scp_from_remote_host "$host" "$remote_path" "$local_path"
}

wait_for_server_running() {
  local server_id="$1"
  local attempt
  local status

  for attempt in $(seq 1 60); do
    status="$(api GET "/servers/$server_id" | jq -r '.server.status')"
    if [[ "$status" == "running" ]]; then
      return 0
    fi
    sleep 3
  done

  echo "error: Hetzner server $server_id did not become running in time" >&2
  return 75
}

wait_for_ssh() {
  local host="${1:-${server_ipv4:-${libcrafter_public_ipv4:-}}}"
  local attempt

  if [[ -z "$host" ]]; then
    echo "error: no Hetzner SSH host is available" >&2
    return 66
  fi

  for attempt in $(seq 1 60); do
    if ssh_remote_host "$host" "true" >/dev/null 2>&1; then
      return 0
    fi
    sleep 5
  done

  echo "error: SSH did not become ready for Hetzner host $host" >&2
  return 75
}

detect_private_interface() {
  local host="$1"
  local override="$private_interface_override"

  ssh_remote_host "$host" "override='$override'; if [ -n \"\$override\" ]; then ip link show \"\$override\" >/dev/null 2>&1 && printf '%s\n' \"\$override\"; exit; fi; default_if=\$(ip route show default 0.0.0.0/0 | awk '{print \$5; exit}'); for dev in \$(ls /sys/class/net); do case \"\$dev\" in lo|\"\$default_if\") continue ;; esac; [ -e \"/sys/class/net/\$dev\" ] && printf '%s\n' \"\$dev\" && exit 0; done; exit 1"
}

read_interface_mac() {
  local host="$1"
  local interface="$2"

  ssh_remote_host "$host" "cat '/sys/class/net/$interface/address'"
}

configure_private_interface() {
  local host="$1"
  local private_ip="$2"
  local attempt
  local detected_interface

  for attempt in $(seq 1 40); do
    if detected_interface="$(detect_private_interface "$host" 2>/dev/null)"; then
      private_interface="$detected_interface"
      ssh_remote_host "$host" "ip link set '$detected_interface' up && ip address replace '$private_ip/$private_prefix_len' dev '$detected_interface'"
      return 0
    fi
    sleep 3
  done

  if [[ -n "$private_interface_override" ]]; then
    echo "error: private interface $private_interface_override did not appear on Hetzner host $host" >&2
  else
    echo "error: no private interface appeared on Hetzner host $host" >&2
  fi
  return 75
}

validate_remote_dir() {
  local remote_dir_value="$1"

  case "$remote_dir_value" in
    /*) ;;
    *)
      echo "error: remote_dir must be an absolute path" >&2
      exit 64
      ;;
  esac
  case "$remote_dir_value" in
    *"'"*)
      echo "error: remote_dir must not contain single quotes" >&2
      exit 64
      ;;
  esac
}

repo_tar_args() {
  printf '%s\n' \
    --exclude=.git \
    --exclude=target \
    --exclude=tools/live-lab/.state \
    --exclude=tools/live-lab/artifacts \
    -czf - \
    .
}

sync_repo_to_endpoint() {
  local role="$1"
  local host="$2"
  local remote_dir_value="$3"
  local tar_args=()

  validate_remote_dir "$remote_dir_value"
  wait_for_ssh "$host"
  ssh_remote_host "$host" "rm -rf '$remote_dir_value' && mkdir -p '$remote_dir_value' '$remote_dir_value/live-artifacts/bootstrap/$role'"
  mapfile -t tar_args < <(repo_tar_args)
  tar -C "$project_root" "${tar_args[@]}" | ssh_remote_host "$host" "tar -xzf - -C '$remote_dir_value'"
}

run_endpoint_script() {
  local role="$1"
  local host="$2"
  local private_ipv4="$3"
  local remote_dir_value="$4"
  local script="$5"
  local quoted_script

  printf -v quoted_script '%q' "$script"
  ssh_remote_host "$host" \
    "cd '$remote_dir_value' && LIBCRAFTER_ENDPOINT_ROLE='$role' LIBCRAFTER_PRIVATE_IPV4='$private_ipv4' bash -lc $quoted_script"
}

