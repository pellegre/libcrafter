        count="${1#--count=}"
        shift
        ;;
      --direction)
        if [[ $# -lt 2 ]]; then
          echo "error: --direction requires a value" >&2
          exit 64
        fi
        direction="$2"
        shift 2
        ;;
      --direction=*)
        direction="${1#--direction=}"
        shift
        ;;
      --corpus)
        if [[ $# -lt 2 ]]; then
          echo "error: --corpus requires a value" >&2
          exit 64
        fi
        corpus_path="$2"
        shift 2
        ;;
      --corpus=*)
        corpus_path="${1#--corpus=}"
        shift
        ;;
      --root|--family|--case|--feature|--index)
        if [[ $# -lt 2 ]]; then
          echo "error: $1 requires a value" >&2
          exit 64
        fi
        generation_args+=("$1" "$2")
        shift 2
        ;;
      --root=*|--family=*|--case=*|--feature=*|--index=*)
        generation_args+=("$1")
        shift
        ;;
      *)
        echo "error: unknown oracle-live suite argument '$1'" >&2
        exit 64
        ;;
    esac
  done

  ensure_dirs
  mkdir -p "$oracle_artifact_dir"
  if [[ -n "$corpus_path" ]]; then
    preserved_corpus_path="$(preserve_suite_corpus "$corpus_path" "$oracle_artifact_dir")"
  else
    rm -rf "$oracle_artifact_dir/corpus"
  fi

  run_doctor --dry-run | tee "$oracle_artifact_dir/doctor.dry-run.log"
  run_create --dry-run | tee "$oracle_artifact_dir/create.dry-run.log"

  if [[ "$dry_run" == true ]]; then
    write_bootstrap_dry_run_artifacts "$oracle_artifact_dir"
