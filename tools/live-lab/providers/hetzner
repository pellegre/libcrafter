        backend="${1#--backend=}"
        shift
        ;;
      --profile)
        if [[ $# -lt 2 ]]; then
          echo "error: --profile requires a value" >&2
          exit 64
        fi
        profile="$2"
        shift 2
        ;;
      --profile=*)
        profile="${1#--profile=}"
        shift
        ;;
      --seed)
        if [[ $# -lt 2 ]]; then
          echo "error: --seed requires a value" >&2
          exit 64
        fi
        seed="$2"
        shift 2
        ;;
      --seed=*)
        seed="${1#--seed=}"
        shift
        ;;
      --count)
        if [[ $# -lt 2 ]]; then
          echo "error: --count requires a value" >&2
          exit 64
        fi
        count="$2"
        shift 2
        ;;
