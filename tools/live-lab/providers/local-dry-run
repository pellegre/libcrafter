#!/usr/bin/env bash
set -euo pipefail

command="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

provider_name="local-dry-run"
state_root="${LIBCRAFTER_LIVE_LAB_STATE_DIR:?LIBCRAFTER_LIVE_LAB_STATE_DIR is required}"
artifact_root="${LIBCRAFTER_LIVE_LAB_ARTIFACT_DIR:?LIBCRAFTER_LIVE_LAB_ARTIFACT_DIR is required}"
project_root="${LIBCRAFTER_PROJECT_ROOT:?LIBCRAFTER_PROJECT_ROOT is required}"

state_dir="$state_root/$provider_name"
artifact_dir="$artifact_root/$provider_name"
manifest="$state_dir/manifest.env"

timestamp_utc() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

suite_arg() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --suite)
        if [[ $# -lt 2 ]]; then
          echo "error: --suite requires a value" >&2
          exit 64
        fi
        printf '%s\n' "$2"
        return 0
        ;;
      --suite=*)
        printf '%s\n' "${1#--suite=}"
        return 0
        ;;
    esac
    shift
  done
}

container_runtime_available() {
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    printf '%s\n' "docker"
    return 0
  fi

  if command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1; then
    printf '%s\n' "podman"
    return 0
  fi

  return 1
}

run_smoke_suite() {
  local runtime
  local smoke_artifact_dir="$artifact_dir/smoke"
  local container_artifact_dir="/workspace/libcrafter/tools/live-lab/artifacts/$provider_name/smoke"

  if [[ ! -f "$manifest" ]]; then
    write_manifest
  fi

  mkdir -p "$smoke_artifact_dir"

  if runtime="$(container_runtime_available)"; then
    LIBCRAFTER_CONTAINER_RUNTIME="$runtime" \
      "$project_root/tools/live-lab/run-in-image.sh" \
      --live \
      -- \
      env "LIBCRAFTER_LIVE_ARTIFACT_DIR=$container_artifact_dir" \
        "LIBCRAFTER_PROJECT_ROOT=/workspace/libcrafter" \
        tests/live/smoke.sh \
      | tee "$artifact_dir/run.log"
  else
    LIBCRAFTER_LIVE_SMOKE_ALLOW_DEGRADED=true \
      LIBCRAFTER_LIVE_ARTIFACT_DIR="$smoke_artifact_dir" \
      "$project_root/tests/live/smoke.sh" \
      | tee "$artifact_dir/run.log"
  fi

  echo "provider=$provider_name"
  echo "ran=true"
  echo "suite=smoke"
  echo "live_packet_tests=false"
  echo "artifact_dir=$smoke_artifact_dir"
  echo "log=$artifact_dir/run.log"
}

run_example_smoke_suite() {
  local requested_suite="${1:-example-smoke}"
  local all_artifact_dir="$artifact_dir/$requested_suite"

  if [[ ! -f "$manifest" ]]; then
    write_manifest
  fi

  mkdir -p "$all_artifact_dir"
  LIBCRAFTER_LIVE_SUITE_MODE=dry-run \
    LIBCRAFTER_LIVE_ARTIFACT_DIR="$all_artifact_dir" \
    LIBCRAFTER_PROJECT_ROOT="$project_root" \
    "$project_root/tests/live/run-all.sh" --dry-run \
    | tee "$artifact_dir/run-all.log"

  echo "provider=$provider_name"
  echo "ran=true"
  echo "suite=$requested_suite"
  echo "suite_kind=legacy-example-smoke"
  echo "live_packet_tests=false"
  echo "artifact_dir=$all_artifact_dir"
  echo "log=$artifact_dir/run-all.log"
}

run_reference_interop_suite() {
  local requested_suite="${1:-reference-interop}"
  local interop_artifact_dir="$artifact_dir/$requested_suite"

  if [[ ! -f "$manifest" ]]; then
    write_manifest
  fi

  mkdir -p "$interop_artifact_dir"
  LIBCRAFTER_LIVE_SUITE_MODE=dry-run \
    LIBCRAFTER_LIVE_ARTIFACT_DIR="$artifact_dir" \
    LIBCRAFTER_PROJECT_ROOT="$project_root" \
    LIBCRAFTER_REFERENCE_INTEROP_SUITE_NAME="$requested_suite" \
    "$project_root/tests/live/scapy-interop.sh" --dry-run \
    | tee "$artifact_dir/$requested_suite.log"

  echo "provider=$provider_name"
  echo "ran=true"
  echo "suite=$requested_suite"
  echo "suite_kind=reference-offline-interop"
  echo "live_packet_tests=false"
  echo "artifact_dir=$interop_artifact_dir"
  echo "log=$artifact_dir/$requested_suite.log"
}

run_oracle_live_suite() {
  local requested_suite="${1:-oracle-live}"
  local oracle_artifact_dir="$artifact_dir/$requested_suite"

  if [[ ! -f "$manifest" ]]; then
    write_manifest
  fi

  mkdir -p "$oracle_artifact_dir"
  "$project_root/tools/oracle/run" live \
    --backend scapy \
    --provider local-dry-run \
    --profile smoke \
    --seed 1 \
    --count 10 \
    --out "$oracle_artifact_dir" \
    | tee "$artifact_dir/$requested_suite.log"

  echo "provider=$provider_name"
  echo "ran=true"
  echo "suite=$requested_suite"
  echo "suite_kind=oracle-live-validation"
  echo "live_packet_tests=false"
  echo "artifact_dir=$oracle_artifact_dir"
  echo "log=$artifact_dir/$requested_suite.log"
}

write_manifest() {
  mkdir -p "$state_dir" "$artifact_dir"
  cat >"$manifest" <<EOF
provider=$provider_name
created_at=$(timestamp_utc)
project_root=$project_root
artifact_dir=$artifact_dir
kind=dry-run
resource_count=0
EOF
}

case "$command" in
  doctor)
    echo "provider=$provider_name"
    echo "status=ok"
    echo "creates_infrastructure=false"
    echo "state_dir=$state_dir"
    echo "artifact_dir=$artifact_dir"
    ;;

  create)
    write_manifest
    cat >"$artifact_dir/create.log" <<EOF
$(timestamp_utc) local-dry-run create completed without infrastructure changes.
EOF
    echo "provider=$provider_name"
    echo "created=true"
    echo "creates_infrastructure=false"
    echo "manifest=$manifest"
    ;;

  run)
    suite="$(suite_arg "$@")"
    if [[ -n "$suite" ]]; then
      case "$suite" in
        smoke)
          run_smoke_suite
          ;;
        all)
          run_example_smoke_suite all
          ;;
        example-smoke)
          run_example_smoke_suite "$suite"
          ;;
        oracle-live)
          run_oracle_live_suite "$suite"
          ;;
        reference-interop | scapy-interop)
          run_reference_interop_suite "$suite"
          ;;
        *)
          echo "error: unknown local-dry-run suite '$suite'" >&2
          exit 64
          ;;
      esac
      exit 0
    fi

    if [[ ! -f "$manifest" ]]; then
      write_manifest
    fi
    mkdir -p "$artifact_dir"
    {
      echo "$(timestamp_utc) local-dry-run run completed without executing live packet tests."
      if [[ $# -gt 0 ]]; then
        printf 'args='
        printf '%q ' "$@"
        printf '\n'
      fi
    } >"$artifact_dir/run.log"
    echo "provider=$provider_name"
    echo "ran=true"
    echo "live_packet_tests=false"
    echo "log=$artifact_dir/run.log"
    ;;

  artifact)
    mkdir -p "$artifact_dir"
    echo "provider=$provider_name"
    echo "artifact_dir=$artifact_dir"
    find "$artifact_dir" -maxdepth 1 -type f -print | sort
    ;;

  destroy)
    rm -rf "$state_dir"
    mkdir -p "$artifact_dir"
    cat >"$artifact_dir/destroy.log" <<EOF
$(timestamp_utc) local-dry-run destroy completed without infrastructure changes.
EOF
    echo "provider=$provider_name"
    echo "destroyed=true"
    echo "creates_infrastructure=false"
    ;;

  *)
    echo "error: unknown local-dry-run command '$command'" >&2
    exit 64
    ;;
esac
