#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/../.." && pwd)"

has_out=0
for arg in "$@"; do
  case "$arg" in
    --out|--out=*)
      has_out=1
      ;;
  esac
done

if [[ "$has_out" -eq 0 ]]; then
  exec "$repo_root/tools/oracle/run" fixtures --backend scapy --out "$repo_root/tests/fixtures/scapy" "$@"
fi

exec "$repo_root/tools/oracle/run" fixtures --backend scapy "$@"
