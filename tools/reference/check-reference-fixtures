#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/../.." && pwd)"

mapfile -t fixtures < <(
  python3 - "$repo_root/tests/fixtures/scapy/cases.json" <<'PY'
import json
from pathlib import Path
import sys

manifest = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
for case in manifest.get("cases", []):
    if case.get("direction") == "scapy_to_libcrafter":
        print(case["name"])
PY
)

out_dir="$(mktemp -d)"
trap 'rm -rf "$out_dir"' EXIT

args=(fixtures --backend scapy --profile smoke --seed 1 --out "$out_dir")
for fixture in "${fixtures[@]}"; do
  args+=(--only "$fixture")
done

"$repo_root/tools/oracle/run" "${args[@]}"

python3 -m json.tool "$out_dir/cases.json" >/dev/null

for fixture in "${fixtures[@]}"; do
  cmp "$repo_root/tests/fixtures/scapy/$fixture.bin" "$out_dir/$fixture.bin"
  python3 -m json.tool "$out_dir/$fixture.json" >/dev/null
done
