#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/../.." && pwd)"
case_manifest="$repo_root/tools/oracle/specs/fixtures/scapy-cases.json"
generator="$script_dir/generate-scapy-fixtures"
validator="$script_dir/scapy-validate-libcrafter.py"
pcap_validator="$script_dir/scapy-pcap-interop.py"

artifact_root="$repo_root/target/scapy-interop"
keep_artifacts=0
smoke=0
only_filters=()
family_filters=()
direction_filters=()

usage() {
  cat <<'USAGE'
usage: tools/reference/check-scapy-interop [options]

Legacy wrapper for offline bidirectional Scapy/libcrafter interop checks.
Common selections delegate to tools/oracle/run offline or pcap.

Options:
  --only NAME             case name filter; repeat or comma-separate values
  --family FAMILY         family filter; repeat or comma-separate values
  --direction DIRECTION   scapy_to_libcrafter, libcrafter_to_scapy, or both
  --smoke                 run the smallest default case unless filters are set
  --out DIR               artifact root (default: target/scapy-interop)
  --keep-artifacts        keep successful run artifacts
  -h, --help              show this help
USAGE
}

require_value() {
  local option="$1"
  local value="${2:-}"
  if [[ -z "$value" ]]; then
    echo "error: $option requires a value" >&2
    exit 2
  fi
}

while (($#)); do
  case "$1" in
    --only)
      require_value "$1" "${2:-}"
      only_filters+=("$2")
      shift 2
      ;;
    --only=*)
      only_filters+=("${1#*=}")
      shift
      ;;
    --family)
      require_value "$1" "${2:-}"
      family_filters+=("$2")
      shift 2
      ;;
    --family=*)
      family_filters+=("${1#*=}")
      shift
      ;;
    --direction)
      require_value "$1" "${2:-}"
      direction_filters+=("$2")
      shift 2
      ;;
    --direction=*)
      direction_filters+=("${1#*=}")
      shift
      ;;
    --smoke)
      smoke=1
      shift
      ;;
    --out)
      require_value "$1" "${2:-}"
      artifact_root="$2"
      shift 2
      ;;
    --out=*)
      artifact_root="${1#*=}"
      shift
      ;;
    --keep-artifacts)
      keep_artifacts=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ "$artifact_root" != /* ]]; then
  artifact_root="$PWD/$artifact_root"
fi

if (( smoke )) && ((${#only_filters[@]} == 0)) && ((${#family_filters[@]} == 0)); then
  only_filters=("ethernet")
fi

run_scapy_to_libcrafter=0
run_libcrafter_to_scapy=0

enable_direction() {
  local direction="$1"
  case "$direction" in
    scapy_to_libcrafter)
      run_scapy_to_libcrafter=1
      ;;
    libcrafter_to_scapy)
      run_libcrafter_to_scapy=1
      ;;
    both)
      run_scapy_to_libcrafter=1
      run_libcrafter_to_scapy=1
      ;;
    "")
      ;;
    *)
      echo "error: unknown direction: $direction" >&2
      exit 2
      ;;
  esac
}

if ((${#direction_filters[@]} == 0)); then
  enable_direction both
else
  for raw_direction in "${direction_filters[@]}"; do
    IFS=',' read -r -a parts <<< "$raw_direction"
    for direction in "${parts[@]}"; do
      direction="${direction//[[:space:]]/}"
      enable_direction "$direction"
    done
  done
fi

delegate_to_oracle() {
  local oracle="$repo_root/tools/oracle/run"
  local oracle_profile="smoke"
  local oracle_count=10
  local raw value
  local -a selected_cases=()
  local -a oracle_families=()
  local -a unsupported_families=()
  local run_pcap=0

  if (( smoke )); then
    oracle_count=1
  fi

  for raw in "${only_filters[@]}"; do
    IFS=',' read -r -a parts <<< "$raw"
    for value in "${parts[@]}"; do
      value="${value//[[:space:]]/}"
      if [[ -n "$value" ]]; then
        selected_cases+=("$value")
      fi
    done
  done
  if ((${#selected_cases[@]} == 0)); then
    selected_cases=("")
  fi

  for raw in "${family_filters[@]}"; do
    IFS=',' read -r -a parts <<< "$raw"
    for value in "${parts[@]}"; do
      value="${value//[[:space:]]/}"
      case "$value" in
        "")
          ;;
        pcap)
          run_pcap=1
          ;;
        ipv4|ipv6)
          oracle_families+=("$value")
          ;;
        *)
          unsupported_families+=("$value")
          ;;
      esac
    done
  done

  if ((${#unsupported_families[@]} > 0)); then
    {
      printf 'warning: tools/reference/check-scapy-interop is legacy; '
      printf 'tools/oracle/run cannot yet map legacy family filter(s):'
      printf ' %s' "${unsupported_families[@]}"
      printf '\n'
      printf 'warning: falling back to legacy fixture orchestration. '
      printf 'Follow-up: add equivalent oracle specs and use tools/oracle/run offline --backend scapy.\n'
    } >&2
    return 1
  fi

  if (( run_pcap == 0 )) && ((${#oracle_families[@]} == 0)); then
    oracle_families=("")
  fi

  run_oracle() {
    local mode="$1"
    local direction="$2"
    local family="$3"
    local case_name="$4"
    local -a cmd=(
      "$oracle" "$mode"
      --backend scapy
      --profile "$oracle_profile"
      --seed 1
      --count "$oracle_count"
      --out "$artifact_root"
    )

    if [[ -n "$direction" ]]; then
      cmd+=(--direction "$direction")
    fi
    if [[ -n "$family" ]]; then
      cmd+=(--family "$family")
    fi
    if [[ -n "$case_name" ]]; then
      cmd+=(--case "$case_name")
    fi
    if (( keep_artifacts )); then
      cmd+=(--keep-artifacts)
    fi

    printf 'legacy wrapper: delegating to' >&2
    printf ' %q' "${cmd[@]}" >&2
    printf '\n' >&2

    if "${cmd[@]}"; then
      return 0
    else
      return "$?"
    fi
  }

  local -a offline_directions=()
  if (( run_scapy_to_libcrafter )); then
    offline_directions+=(reference_to_libcrafter)
  fi
  if (( run_libcrafter_to_scapy )); then
    offline_directions+=(libcrafter_to_reference)
  fi

  local pcap_direction=""
  if (( run_pcap )); then
    if (( run_scapy_to_libcrafter && run_libcrafter_to_scapy )); then
      pcap_direction="roundtrip"
    elif (( run_scapy_to_libcrafter )); then
      pcap_direction="reference_to_libcrafter"
    elif (( run_libcrafter_to_scapy )); then
      pcap_direction="libcrafter_to_reference"
    fi

    for case_name in "${selected_cases[@]}"; do
      run_oracle pcap "$pcap_direction" "" "$case_name"
    done
  fi

  local family case_name direction
  for family in "${oracle_families[@]}"; do
    for case_name in "${selected_cases[@]}"; do
      for direction in "${offline_directions[@]}"; do
        run_oracle offline "$direction" "$family" "$case_name"
      done
    done
  done

  echo "scapy interop checks passed"
}

mkdir -p "$artifact_root"
run_dir="$(mktemp -d "$artifact_root/run.XXXXXX")"
logs_dir="$run_dir/logs"
mkdir -p "$logs_dir"

cleanup() {
  rc=$?
  if (( rc == 0 && keep_artifacts == 0 )); then
    rm -rf -- "$run_dir"
  else
    echo "artifacts: $run_dir" >&2
  fi
  exit "$rc"
}
trap cleanup EXIT

if delegate_to_oracle; then
  exit 0
fi

filter_args=()
for value in "${only_filters[@]}"; do
  filter_args+=(--only "$value")
done

pcap_family_requested=0
non_pcap_family_filters=()
for raw_family in "${family_filters[@]}"; do
  IFS=',' read -r -a family_parts <<< "$raw_family"
  for family in "${family_parts[@]}"; do
    family="${family//[[:space:]]/}"
    if [[ -z "$family" ]]; then
      continue
    fi
    if [[ "$family" == "pcap" ]]; then
      pcap_family_requested=1
    else
      non_pcap_family_filters+=("$family")
    fi
  done
done

for value in "${non_pcap_family_filters[@]}"; do
  filter_args+=(--family "$value")
done

run_logged() {
  local label="$1"
  local direction="$2"
  local case_label="$3"
  shift 3
  local log="$logs_dir/$label.log"

  printf 'running direction=%s case=%s step=%s\n' "$direction" "$case_label" "$label"
  printf 'command:' > "$log"
  printf ' %q' "$@" >> "$log"
  printf '\n\n' >> "$log"

  if "$@" >> "$log" 2>&1; then
    printf 'ok direction=%s case=%s step=%s\n' "$direction" "$case_label" "$label"
    return 0
  else
    rc=$?
  fi

  printf 'failed direction=%s case=%s step=%s exit=%s\n' \
    "$direction" "$case_label" "$label" "$rc" >&2
  tail -n 80 "$log" >&2 || true
  return "$rc"
}

run_capture() {
  local label="$1"
  local direction="$2"
  local case_label="$3"
  local output="$4"
  shift 4
  local log="$logs_dir/$label.log"

  printf 'running direction=%s case=%s step=%s\n' "$direction" "$case_label" "$label"
  printf 'command:' > "$log"
  printf ' %q' "$@" >> "$log"
  printf ' > %q\n\n' "$output" >> "$log"

  if "$@" > "$output" 2>> "$log"; then
    printf 'ok direction=%s case=%s step=%s\n' "$direction" "$case_label" "$label"
    return 0
  else
    rc=$?
  fi

  printf 'failed direction=%s case=%s step=%s exit=%s\n' \
    "$direction" "$case_label" "$label" "$rc" >&2
  tail -n 80 "$log" >&2 || true
  return "$rc"
}

select_scapy_cases() {
  local manifest_out="$1"
  local names_out="$2"
  shift 2

  python3 - "$case_manifest" "$manifest_out" "$names_out" "$@" <<'PY'
import argparse
import json
from pathlib import Path
import sys


def split_filters(values):
    out = []
    for raw in values:
        for value in raw.split(","):
            value = value.strip()
            if value:
                out.append(value)
    return out


parser = argparse.ArgumentParser()
parser.add_argument("source", type=Path)
parser.add_argument("manifest_out", type=Path)
parser.add_argument("names_out", type=Path)
parser.add_argument("--only", action="append", default=[])
parser.add_argument("--family", action="append", default=[])
args = parser.parse_args()

manifest = json.loads(args.source.read_text(encoding="utf-8"))
cases = [
    case
    for case in manifest.get("cases", [])
    if isinstance(case, dict) and case.get("direction") == "scapy_to_libcrafter"
]
names = split_filters(args.only)
families = split_filters(args.family)

known_names = {case.get("name") for case in cases}
unknown_names = sorted(set(names) - known_names)
if unknown_names:
    print(
        "unknown scapy_to_libcrafter case(s): "
        + ", ".join(unknown_names)
        + ". known: "
        + ", ".join(sorted(str(name) for name in known_names if name)),
        file=sys.stderr,
    )
    sys.exit(2)

known_families = {case.get("family") for case in cases}
unknown_families = sorted(set(families) - known_families)
if unknown_families:
    print(
        "unknown scapy_to_libcrafter family/families: "
        + ", ".join(unknown_families)
        + ". known: "
        + ", ".join(sorted(str(family) for family in known_families if family)),
        file=sys.stderr,
    )
    sys.exit(2)

if names:
    selected = [case for case in cases if case.get("name") in set(names)]
else:
    selected = [case for case in cases if case.get("status") == "implemented"]

if families:
    selected = [case for case in selected if case.get("family") in set(families)]

if not selected:
    print("no scapy_to_libcrafter cases selected", file=sys.stderr)
    sys.exit(2)

filtered = dict(manifest)
filtered["cases"] = selected
args.manifest_out.write_text(
    json.dumps(filtered, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
args.names_out.write_text(
    "".join(f"{case['name']}\n" for case in selected),
    encoding="utf-8",
)
PY
}

case_label="selected"

if (( pcap_family_requested )); then
  pcap_args=(--out "$run_dir/pcap")
  if (( run_scapy_to_libcrafter )); then
    pcap_args+=(--direction scapy_to_libcrafter)
  fi
  if (( run_libcrafter_to_scapy )); then
    pcap_args+=(--direction libcrafter_to_scapy)
  fi

  run_logged \
    scapy-pcap-interop \
    both \
    pcap \
    "$pcap_validator" "${pcap_args[@]}"

  if ((${#non_pcap_family_filters[@]} == 0)); then
    echo "scapy interop checks passed"
    exit 0
  fi
fi

if (( run_scapy_to_libcrafter )); then
  scapy_dir="$run_dir/scapy-fixtures"
  scapy_manifest="$scapy_dir/cases.json"
  scapy_names_file="$run_dir/scapy-selected.txt"
  mkdir -p "$scapy_dir"

  if select_scapy_cases "$scapy_manifest" "$scapy_names_file" "${filter_args[@]}"; then
    :
  else
    rc=$?
    printf 'failed direction=%s case=%s step=%s exit=%s\n' \
      scapy_to_libcrafter "$case_label" select-scapy-cases "$rc" >&2
    exit "$rc"
  fi
  mapfile -t scapy_names < "$scapy_names_file"

  generator_args=(--out "$scapy_dir" --direction scapy_to_libcrafter)
  for name in "${scapy_names[@]}"; do
    generator_args+=(--only "$name")
  done

  run_logged \
    generate-scapy-fixtures \
    scapy_to_libcrafter \
    "$case_label" \
    "$generator" "${generator_args[@]}"

  run_logged \
    rust-scapy-decode \
    scapy_to_libcrafter \
    "$case_label" \
    env LIBCRAFTER_SCAPY_FIXTURE_DIR="$scapy_dir" \
      cargo test -p crafter --test scapy_reference -- \
      scapy_generated_fixtures_decode_like_manifest --exact
fi

if (( run_libcrafter_to_scapy )); then
  vector_json="$run_dir/libcrafter-vectors.json"
  decoded_dir="$run_dir/scapy-decoded-libcrafter"

  run_capture \
    emit-libcrafter-vectors \
    libcrafter_to_scapy \
    "$case_label" \
    "$vector_json" \
    cargo run -q -p crafter --example scapy_interop_vectors -- --json

  run_logged \
    scapy-validate-libcrafter \
    libcrafter_to_scapy \
    "$case_label" \
    "$validator" --input "$vector_json" --out "$decoded_dir" \
      --direction libcrafter_to_scapy "${filter_args[@]}"
fi

echo "scapy interop checks passed"
