#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
usage: .agents/scripts/check-crafter-release [--static|--package-only]

Runs the local crafter release gate without publishing.

  --static        run fmt, clippy, tests, example builds, docs, and package inspection
  --package-only run package creation and package content inspection only
USAGE
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

temp_paths=()
cleanup_temp_paths() {
  local path

  for path in "${temp_paths[@]}"; do
    rm -rf "$path"
  done
}

lockfile_existed=0
cleanup_lockfile() {
  if [[ "$lockfile_existed" -eq 0 && -f Cargo.lock ]]; then
    rm -f Cargo.lock
  fi
}

cleanup() {
  cleanup_temp_paths
  cleanup_lockfile
}
trap cleanup EXIT

run() {
  printf '\n==> %s\n' "$*"
  "$@"
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

mode="${1:---static}"
if [[ $# -gt 1 ]]; then
  usage >&2
  exit 2
fi

case "$mode" in
  --static | --package-only)
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

crate_name="crafter"
cargo_offline_flags=(--locked --offline)

ensure_ephemeral_lockfile() {
  if [[ -f Cargo.lock ]]; then
    lockfile_existed=1
  fi

  run cargo generate-lockfile
  run cargo fetch --locked
}

inspect_package_contents() {
  local crate_file="$1"
  local tmp_dir
  local package_members
  local normalized_members
  local forbidden_members

  [[ -f "$crate_file" ]] || die "package archive not found: $crate_file"

  tmp_dir="$(mktemp -d)"
  temp_paths+=("$tmp_dir")
  package_members="$tmp_dir/package-members"
  normalized_members="$tmp_dir/normalized-members"
  forbidden_members="$tmp_dir/forbidden-members"

  run tar -tf "$crate_file"
  tar -tf "$crate_file" >"$package_members"
  awk '{ sub(/^[^/]+\//, "", $0); print }' "$package_members" >"$normalized_members"

  awk '
    {
      path = $0
      sub(/^[^/]+\//, "", path)

      if (path ~ /(^|\/)(\.agents|\.clew|\.github|\.githooks|\.libcrafter-live|target)(\/|$)/ ||
          path ~ /(^|\/)(\.codex|\.cursor|\.idea|\.vscode)(\/|$)/ ||
          path ~ /^tools\/(git-hooks|live-lab|policy|reference)(\/|$)/ ||
          path ~ /^tests\/live(\/|$)/ ||
          path ~ /^crates\/(crafter-core|crafter-live|crafter-net|crafter-pcap|core|live|net|pcap)(\/|$)/) {
        print path
      }
    }
  ' "$package_members" >"$forbidden_members"

  if [[ -s "$forbidden_members" ]]; then
    printf '\nforbidden package members:\n' >&2
    sed 's/^/  - /' "$forbidden_members" >&2
    die "package contains repo-local execution substrate"
  fi

  if ! grep -Fxq 'Cargo.toml' "$normalized_members"; then
    die "package archive is missing Cargo.toml"
  fi

  if ! grep -Fxq 'src/lib.rs' "$normalized_members"; then
    die "package archive is missing src/lib.rs"
  fi

  rm -rf "$tmp_dir"
}

create_and_inspect_package() {
  local crate_file

  rm -f "target/package/${crate_name}-"*.crate
  run cargo package -p "$crate_name" --allow-dirty --no-verify "${cargo_offline_flags[@]}"

  crate_file="$(find target/package -maxdepth 1 -type f -name "${crate_name}-*.crate" -printf '%T@ %p\n' | sort -nr | awk 'NR == 1 { print $2 }')"
  [[ -n "$crate_file" ]] || die "cargo package did not create a ${crate_name} archive"

  inspect_package_contents "$crate_file"
}

if [[ "$mode" == "--static" ]]; then
  ensure_ephemeral_lockfile

  run cargo fmt --all -- --check
  run cargo clippy -p "$crate_name" --all-targets --all-features "${cargo_offline_flags[@]}"
  run cargo test -p "$crate_name" --all-targets "${cargo_offline_flags[@]}"
  run cargo build -p "$crate_name" --examples "${cargo_offline_flags[@]}"
  run env RUSTDOCFLAGS="${RUSTDOCFLAGS:-} -D warnings" cargo doc -p "$crate_name" --no-deps "${cargo_offline_flags[@]}"
else
  ensure_ephemeral_lockfile
fi

create_and_inspect_package
